# Contoh .env untuk server produksi. Salin ke .env, lalu sesuaikan setiap nilai.
APP_NAME="BPP Pertanian Routa"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://alamat-domain-anda.go.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Di belakang Nginx/Cloudflare/load balancer, isi agar IP pengunjung terbaca benar (rate limiting dan log).
# TRUSTED_PROXIES=*

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpp_pertanian_routa
DB_USERNAME=isi_user_khusus_aplikasi
DB_PASSWORD=isi_kata_sandi_kuat

# Sesi: cookie hanya lewat HTTPS dan terenkripsi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Header keamanan. HSTS hanya dikirim lewat HTTPS. Matikan CSP hanya jika terpaksa.
CSP_ENABLED=true
HSTS_ENABLED=true

# Surat keluar (belum dipakai fitur bawaan, disiapkan untuk pengembangan berikutnya).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@alamat-domain-anda.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Akun admin pertama (dipakai saat php artisan migrate --seed). Ganti sandi setelah login pertama.
ADMIN_EMAIL=
ADMIN_PASSWORD=
